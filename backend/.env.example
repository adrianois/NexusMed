# ============================================
# Supabase
# ============================================
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sua_chave_anon_aqui

# JWT
JWT_SECRET=sua_chave_secreta_jwt_aqui

# Servidor
PORT=4000
FRONTEND_URL=https://seu-frontend.vercel.app

# ============================================
# E-mail (Gmail com Senha de App)
# IMPORTANTE: Use uma Senha de App, NÃO a senha normal do Gmail.
# Como gerar: https://myaccount.google.com/apppasswords
# (Verificação em 2 etapas precisa estar ativa)
# ============================================
EMAIL_USER=seu@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ============================================
# API Assinatura Eletrônica GOV.BR
# Solicite as credenciais em:
# https://www.gov.br/governodigital/integrarprodutoid
# ============================================
GOVBR_CLIENT_ID=seu_client_id_aqui
GOVBR_CLIENT_SECRET=seu_client_secret_aqui
GOVBR_REDIRECT_URI=http://localhost:4000/assinatura/callback

# Staging (homologação - use para testes, code fixo: 12345)
GOVBR_OAUTH_URL=https://cas.staging.iti.br
GOVBR_API_URL=https://assinatura-api.staging.iti.br

# Produção (descomente quando estiver pronto)
# GOVBR_OAUTH_URL=https://cas.iti.br
# GOVBR_API_URL=https://assinatura-api.iti.br

# Diretório para salvar os arquivos .p7s assinados
ASSINATURA_UPLOAD_DIR=./uploads/assinaturas

# ============================================
# WhatsApp Business Cloud API (Meta)
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
# ============================================
WHATSAPP_PHONE_NUMBER_ID=1103886356131050
WHATSAPP_BUSINESS_ACCOUNT_ID=889937783854557
WHATSAPP_TOKEN=seu_access_token_permanente_aqui
WHATSAPP_WEBHOOK_VERIFY_TOKEN=um_token_secreto_qualquer
